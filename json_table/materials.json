{
  "title": "Wide- and ultrawide-bandgap semiconductor tradeoff",
  "temperature_k": 300,
  "default_materials": ["si", "diamond", "aln", "gan","4h-sic" ],
  "properties": {
    "band_gap": {
      "name": "Bandgap",
      "unit": "eV",
      "axis_max": 10,
      "scale": "linear",
      "default_axis": true
    },
    "breakdown_field": {
      "name": "Breakdown Field",
      "unit": "MV/cm",
      "axis_max": 20,
      "scale": "linear",
      "default_axis": true,
      "note": "Measured at N_D = 1e16 cm\u207b\u00b3. Silicon reads 0.42 here, not the textbook 0.3, because 0.3 is the same physics at N_D \u2248 1e15 cm\u207b\u00b3."
    },
    "electron_mobility": {
      "name": "Mobility",
      "unit": "cm\u00b2/V\u00b7s",
      "axis_min": 1,
      "axis_max": 100000,
      "scale": "log",
      "default_axis": true
    },
    "saturation_velocity": {
      "name": "Saturation Velocity",
      "unit": "10\u2077 cm/s",
      "axis_max": 5,
      "scale": "linear",
      "default_axis": true
    },
    "thermal_conductivity": {
      "name": "Thermal Conductivity",
      "unit": "W/cm\u00b7K",
      "axis_max": 22,
      "ticks": [1, 2, 3, 5, 22],
      "tick_break": 4,
      "tick_note": "Segmented axis: rings 1-4 resolve the 0-5 W/cm\u00b7K band where most materials sit, ring 5 jumps to 22 to accommodate diamond.",
      "note": "Single-axis measurement, never averaged across directions.",
      "scale": "linear",
      "default_axis": true
    },
    "hole_mobility": {
      "name": "Hole Mobility",
      "unit": "cm\u00b2/V\u00b7s",
      "axis_min": 1,
      "axis_max": 100000,
      "scale": "log",
      "default_axis": false
    },
    "relative_permittivity": {
      "name": "Relative Permittivity",
      "unit": "",
      "axis_max": 15,
      "scale": "linear",
      "default_axis": false,
      "note": "Static (low-frequency) dielectric constant, E perpendicular c for uniaxial crystals."
    }
  },
  "functions": {
    "note": "",
    "band_gap": {
      "form": "Varshni",
      "expression": "E_g(T) = {Eg0} \u2212 {a}\u00b7T\u00b2 / (T + {b})",
      "terms": [
        {"symbol": "Eg0", "display": "E_g(0)", "unit": "eV"},
        {"symbol": "a", "display": "\u03b1", "unit": "eV/K"},
        {"symbol": "b", "display": "\u03b2", "unit": "K"}
      ]
    },
    "breakdown_field": {
      "form": "Chynoweth impact ionisation",
      "expression": "\u03b1(E,T) = a(T)\u00b7exp(\u2212{b} / E),    a(T) = {a0} + {a1}\u00b7T",
      "terms": [
        {"symbol": "a0", "display": "a_0", "unit": "1/cm"},
        {"symbol": "a1", "display": "a_1", "unit": "1/cm\u00b7K"},
        {"symbol": "b", "display": "b", "unit": "V/cm"}
      ]
    },
    "electron_mobility": {
      "form": "lattice-scattering power law",
      "expression": "\u03bc_n(T) = {mu0}\u00b7(300 / T){^n}",
      "terms": [
        {"symbol": "mu0", "display": "\u03bc_0", "unit": "cm\u00b2/V\u00b7s"},
        {"symbol": "n", "display": "n", "unit": ""}
      ]
    },
    "hole_mobility": {
      "form": "lattice-scattering power law",
      "expression": "\u03bc_p(T) = {mu0}\u00b7(300 / T){^n}",
      "terms": [
        {"symbol": "mu0", "display": "\u03bc_0", "unit": "cm\u00b2/V\u00b7s"},
        {"symbol": "n", "display": "n", "unit": ""}
      ]
    },
    "saturation_velocity": {
      "form": "Jacoboni",
      "expression": "v_{sat}(T) = {v0} / (1 + {A}\u00b7exp(T / {theta}))",
      "terms": [
        {"symbol": "v0", "display": "v_0", "unit": "10\u2077 cm/s"},
        {"symbol": "A", "display": "A", "unit": ""},
        {"symbol": "theta", "display": "\u03b8", "unit": "K"}
      ]
    },
    "thermal_conductivity": {
      "form": "Umklapp power law",
      "expression": "\u03ba(T) = {k300}\u00b7(300 / T){^m}",
      "terms": [
        {"symbol": "k300", "display": "\u03ba_{300}", "unit": "W/cm\u00b7K"},
        {"symbol": "m", "display": "m", "unit": ""}
      ]
    },
    "relative_permittivity": {
      "form": "linear",
      "expression": "\u03b5_r(T) = {eps300}\u00b7(1 + {c}\u00b7(T \u2212 300))",
      "terms": [
        {"symbol": "eps300", "display": "\u03b5_{300}", "unit": ""},
        {"symbol": "c", "display": "c", "unit": "1/K"}
      ]
    }
  },
